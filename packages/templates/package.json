{
  "name": "@agent-blueprint/templates",
  "version": "0.1.0",
  "private": true,
  "description": "Starter blueprints and per-artifact templates, expressed as ChangeSets.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "starters:seed": "tsx scripts/seed-starters.ts"
  },
  "dependencies": {
    "@agent-blueprint/core": "workspace:*"
  },
  "devDependencies": {
    "@agent-blueprint/eslint-config": "workspace:*",
    "@agent-blueprint/tsconfig": "workspace:*",
    "@types/node": "26.5.0",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
