{
  "name": "@agent-blueprint/core",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical Blueprint model, schemas, project format, validation, dependencies, migrations and change-sets.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:canonicalize": "tsx scripts/canonicalize-fixtures.ts",
    "options:doc": "tsx scripts/options-doc.ts"
  },
  "dependencies": {
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@agent-blueprint/eslint-config": "workspace:*",
    "@agent-blueprint/fixtures": "workspace:*",
    "@agent-blueprint/tsconfig": "workspace:*",
    "@types/node": "26.5.0",
    "eslint": "9.39.5",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
