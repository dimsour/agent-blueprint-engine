# Every value here is optional. The app runs with none of them.

# Hosts the AI relay at /api/ai/proxy may forward to, comma-separated.
# Defaults to localhost, 127.0.0.1 and [::1]. Use "*" only on a deployment nobody else can
# reach: without a list, a public deployment is an open relay.
AI_PROXY_ALLOWED_HOSTS=localhost,127.0.0.1

# Enables the GitHub OAuth route handlers (roadmap P7). Without them the UI offers only a
# personal access token, which needs no configuration at all.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
