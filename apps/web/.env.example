# Every variable here is optional. The app is fully usable with none of them set: it is
# local-first, it stores nothing on the server, and both route handlers exist only to work
# around a browser limitation. See docs/08-security.md.

# --- GitHub sign-in (optional) ------------------------------------------------------------
# Set both to offer "Sign in with GitHub" as well as pasting a personal access token. Without
# them the UI shows only the token path, and /api/github/oauth/* answers 404.
# Register the OAuth app's callback URL as <APP_ORIGIN>/api/github/oauth/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# This app's public origin, used for the OAuth redirect and as the target the token is posted
# back to. Set it on a deployment that does not sit behind a proxy it trusts: without it, the
# forwarded host headers are believed. Example: https://blueprint.example.com
APP_ORIGIN=

# --- AI relay (optional) ------------------------------------------------------------------
# Hosts /api/ai/proxy may relay to, comma-separated. The proxy exists for endpoints that send
# no CORS headers, which is the usual case for a local Ollama or vLLM. Anything not listed is
# refused, so a deployed instance cannot be used as an open relay. `*` disables the check and
# should not be set on anything reachable from the internet.
AI_PROXY_ALLOWED_HOSTS=localhost,127.0.0.1
